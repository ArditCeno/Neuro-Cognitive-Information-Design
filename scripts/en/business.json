      "qA": [["Opportunities (O) are factors:", ["Internal", "Legal only", "External", "Financial only"], 2], ["Growing market demand is a:", ["Strength", "Opportunity", "Threat", "Weakness"], 1], ["A new competitor with low prices is a:", ["Strength", "Opportunity", "Weakness", "Threat"], 3]],
      "qB": [["Strengths (S) are:", ["Competitors", "External", "Internal", "Taxes"], 2], ["Untrained staff is a:", ["Threat", "Weakness", "Strength", "Opportunity"], 1], ["The 'S-O' strategy means:", ["Close the business", "Avoid threats", "Use strengths for opportunities", "Delete weaknesses"], 2]]
    },
