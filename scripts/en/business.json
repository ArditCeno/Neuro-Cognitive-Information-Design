      "title": "M1 - Basic indicators",
      "facts": ["Revenue = price x quantity", "Cost = fixed + variable", "Profit = revenue - cost", "Market share = firm sales / market sales", "Example: price 20, quantity 500 -> revenue 10,000"],
      "qA": [["Revenue with price 20 and quantity 500:", ["10,000", "520", "1,000", "2,500"], 0], ["Firm sales 200, market 2000. Market share:", ["10%", "1%", "5%", "20%"], 0], ["Price falls from 20 to 18 but quantity stays 500. Revenue:", ["9,000", "10,000", "11,000", "8,000"], 0]],
      "qB": [["Profit =", ["Revenue + cost", "Revenue - cost", "Price x cost", "Cost - revenue"], 1], ["Total cost 6,000 and revenue 10,000. Profit:", ["10,000", "6,000", "16,000", "4,000"], 3], ["Profit 2,000 with revenue 10,000. Margin:", ["2%", "200%", "8%", "20%"], 3]]
    },
    "fillestar|m2": {
      "title": "M2 - SMART objectives",
      "facts": ["S = Specific", "M = Measurable", "A = Achievable", "R = Relevant", "T = Time-bound"],
      "qA": [["'M' in SMART is:", ["Magnitude", "Good", "Measurable", "Average"], 2], ["Which objective is SMART?", ["Be better", "Increase sales", "Sell more", "Increase sales by 10% by 31 December"], 3], ["Objective: +200% sales in 1 week, without resources. Main criticism:", ["Specific", "Not relevant", "Not achievable", "Not time-bound"], 2]],
      "qB": [["'T' in SMART is:", ["Tax", "Market", "Time-bound", "Technical"], 2], ["'Increase customer satisfaction' lacks:", ["Measurability and a deadline", "Only specificity", "Only relevance", "Nothing"], 0], ["Why do SMART objectives help?", ["They enable measurement and accountability", "They replace strategy", "They are forbidden", "No effect"], 0]]
    },
    "fillestar|m3": {
      "title": "M3 - Cost and simple break-even",
      "facts": ["Break-even (units) = fixed cost / (price - variable cost)", "Example: fixed 2,000, price 10, variable 6 -> 500 units", "Above break-even: profit", "Below break-even: loss", "Raising the price lowers the break-even"],
      "qA": [["Above break-even the business has:", ["Profit", "Loss", "Always zero", "Taxes"], 0], ["Fixed 2,000, price 10, variable 6. Break-even:", ["2,000", "333", "500", "200"], 2], ["Sales 600 units (example above). Profit:", ["0", "600", "400", "1,000"], 2]],
      "qB": [["Below break-even:", ["Profit", "Zero", "Loss", "Growth"], 2], ["Raising the price (others equal) makes break-even:", ["Unchanged", "Higher", "Lower", "Double"], 2], ["Price 12, variable 6, fixed 2,000. Break-even:", ["1,000", "333", "200", "500"], 1]]
    },
